            "api",
            "cumlists?page=1&pageSize=20&state=READY_FOR_SIGN"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Has items and pageInfo', function () { pm.expect(json).to.have.property('items'); pm.expect(json).to.have.property('pageInfo'); });"
            ]
          }
        }
